# Copy this file to .env and adjust for this host -- .env itself is
# gitignored (host-specific, never shared/committed). Every value here has
# a working default in docker-compose.yml if you don't set it at all;
# a bare `docker compose up` with no .env creates ./data and ./state next
# to the compose file, which is fine for a quick local try but NOT where
# you want real project data/secrets living long-term on a real deployment.

# Host port the GUI is reached on (bound to 127.0.0.1 only -- see
# docker-compose.yml's own comment on why that bind is deliberate).
# WEB_UI_PORT=8420

# Where rendered videos/keyframes/specs live. Point this at real, backed-up
# storage for anything you don't want to lose.
# DREAM_PIPELINE_DATA_DIR=/srv/dream-pipeline/projects

# Where config.json and encrypted secrets (Gemini key, YouTube OAuth) live.
# Keep this OUTSIDE the data dir above and outside the repo -- see
# secret_store.py's docstring for what this encryption does and doesn't
# protect against.
# DREAM_PIPELINE_STATE_DIR=/srv/dream-pipeline/state

# Ollama/ComfyUI endpoints -- applied to config.json on every container
# start (see entrypoint.sh), saving setting these by hand in Settings on a
# fresh install. Settings can still override either afterward; leave
# unset to configure entirely through Settings instead. NOT for the
# Gemini API key -- that's a real secret and has no env var here on
# purpose (see docker-compose.yml's own comment); paste it in Settings.
# OLLAMA_URL=http://host.docker.internal:11434
# COMFYUI_URL=http://host.docker.internal:8188

# Optional hardening, off by default. When set, web_ui.py also refuses
# requests whose Host header isn't one of these names (comma-separated),
# which defeats DNS rebinding on top of the always-on cross-site check.
# Use the exact name(s) you type into the browser -- for a reverse proxy,
# the vhost name. Leave unset if unsure; nothing breaks without it.
# DREAM_PIPELINE_ALLOWED_HOSTS=dream.home.lan,192.168.1.20

# --- "Complete" Docker profile only (see README.md's Lite vs Complete
# section) -- run_complete.sh/.bat already set sensible defaults for
# all of these, you normally don't need to touch this section at all.

# Which two Ollama models the complete profile pulls automatically on
# first start (see README's "Tested models" table for why these two).
# CREATIVE_MODEL=gemma4:12b
# VISION_MODEL=qwen3-vl:8b

# Which ComfyUI checkpoint + text encoder the complete profile downloads
# automatically on first start (default: workflow_api_fml2v.json's own
# requirements -- our tested default workflow). Together with the fixed
# small vae/upscaler companions also fetched alongside these, total
# first-run download is ~38 GB. Override to use a different
# workflow_api_*.json's models instead -- see install_manifest.py for
# each workflow's filenames/sources -- and update Settings' workflow
# choice to match.
# COMFYUI_CHECKPOINT_URL=https://huggingface.co/Kijai/LTX2.3_comfy/resolve/main/diffusion_models/ltx-2.3-22b-distilled-1.1_transformer_only_fp8_scaled.safetensors
# COMFYUI_TEXT_ENCODER_URL=https://huggingface.co/Comfy-Org/ltx-2/resolve/main/split_files/text_encoders/gemma_3_12B_it_fp8_scaled.safetensors

# Host port ComfyUI's own web UI is reached on, if you want to open it
# directly (Dream Pipeline talks to it over the internal Docker network
# regardless of this).
# COMFYUI_PORT=8188

# Where the bundled Ollama's model weights / ComfyUI's run+data
# directories live. Same "point at real backed-up storage for a real
# deployment" reasoning as DREAM_PIPELINE_DATA_DIR/STATE_DIR above --
# defaults land next to this file, fine for a quick try.
# DREAM_PIPELINE_OLLAMA_DIR=/srv/dream-pipeline/ollama
# DREAM_PIPELINE_COMFYUI_RUN_DIR=/srv/dream-pipeline/comfyui-run
# DREAM_PIPELINE_COMFYUI_DATA_DIR=/srv/dream-pipeline/comfyui-data

# Linux/macOS only -- the uid/gid ComfyUI's container runs as, so files
# it writes into the volumes above are owned by YOUR user, not root.
# Defaults to 1000 (the first real user on most single-user Linux
# installs) -- check `id -u`/`id -g` if that's not you.
# WANTED_UID=1000
# WANTED_GID=1000
