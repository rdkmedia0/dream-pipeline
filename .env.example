# Copy this file to .env and adjust for this host -- .env itself is
# gitignored (host-specific, never shared/committed). Every value here has
# a working default in docker-compose.yml if you don't set it at all;
# a bare `docker compose up` with no .env creates ./data and ./state next
# to the compose file, which is fine for a quick local try but NOT where
# you want real project data/secrets living long-term on a real deployment.

# Host port the GUI is reached on (bound to 127.0.0.1 only -- see
# docker-compose.yml's own comment on why that bind is deliberate).
# WEB_UI_PORT=8420

# Where rendered videos/keyframes/specs live. Point this at real, backed-up
# storage for anything you don't want to lose.
# DREAM_PIPELINE_DATA_DIR=/srv/data/filestash/users/ytProjects/data/projects

# Where config.json and encrypted secrets (Gemini key, YouTube OAuth) live.
# Keep this OUTSIDE the data dir above and outside the repo -- see
# secret_store.py's docstring for what this encryption does and doesn't
# protect against.
# DREAM_PIPELINE_STATE_DIR=/srv/data/filestash/users/ytProjects/data/state

# Ollama/ComfyUI endpoints -- applied to config.json on every container
# start (see entrypoint.sh), saving setting these by hand in Settings on a
# fresh install. Settings can still override either afterward; leave
# unset to configure entirely through Settings instead. NOT for the
# Gemini API key -- that's a real secret and has no env var here on
# purpose (see docker-compose.yml's own comment); paste it in Settings.
# OLLAMA_URL=http://host.docker.internal:11434
# COMFYUI_URL=http://host.docker.internal:8188
