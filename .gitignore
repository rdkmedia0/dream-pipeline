# Machine-specific, private, or generated -- never belongs in the repo.
# Same exclusion reasoning as .dockerignore (secrets/config must never
# ship baked into an image OR a commit); kept in sync with it.

# Local runtime config -- network topology, model choices, per-machine.
# The GUI's Settings screen is the only thing that should ever write this.
_pipeline/config.json

# Encrypted secrets at rest (Gemini API key, YouTube OAuth client/token) --
# see secret_store.py's own docstring on what this encryption does and
# doesn't protect against. Never committed regardless.
**/*.enc
_pipeline/gemini/
_pipeline/youtube/
_pipeline/gemini/usage.json
_pipeline/model_check_cache.json

# Project data (rendered videos, keyframes, specs, index.json) and Docker
# state (config.json + secrets) -- both live entirely outside this repo in
# a real deployment, but docker-compose.yml's default volume paths land
# them here (./data, ./state) when no .env override is set, so ignore
# both in case that happens during local testing.
/data/
/state/

# Per-host override of docker-compose.yml's default volume paths -- see
# .env.example for what this can set. Real values are host-specific,
# never shared/committed.
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Browser automation cache (Playwright/etc, if ever installed locally)
_pipeline/browsers/

# Editor/OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# AI-agent tooling (Claude Code skills/hooks/config) -- kept on disk for
# local development, not part of the distributable tool itself.
/CLAUDE.md
/.claude/
